APP_NAME=AI Paper Generator
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_paper_generator

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50

OCR_ENABLED=true
OCR_LANGUAGE=eng
DOCUMENT_PROCESSING_STALE_MINUTES=15

GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

RAG_RATE_LIMIT_REQUESTS=10
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_RELEVANCE_THRESHOLD=0.45
